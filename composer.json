{
  "name": "oceanviewflats/backend-api",
  "description": "OceanViewFlats PHP REST API with OpenAPI Specification",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "zircote/swagger-php": "^4.11",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "OceanViewFlats\\Api\\": "public/api/",
      "OceanViewFlats\\Domain\\": "src/Domain/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OceanViewFlats\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "generate-docs": "php scripts/generate-docs.php"
  },
  "config": {
    "allow-plugins": {}
  }
}
