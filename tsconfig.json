{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["src/**/*", "render.tsx", "vite.config.ts"],
	"exclude": ["node_modules", "dist", "vendor"]
}
